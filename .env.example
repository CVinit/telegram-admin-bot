# Disable Dujiao admin login captcha before using bot login.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# Host deployment example. In docker-compose, override this to http://api:8080/api/v1
DUJIAO_BASE_URL=http://127.0.0.1:8080/api/v1
SQLITE_PATH=./data/bot.db
ACTION_CONFIRM_TTL_SECONDS=300
SESSION_EXPIRE_SKEW_SECONDS=60
LOG_LEVEL=info
